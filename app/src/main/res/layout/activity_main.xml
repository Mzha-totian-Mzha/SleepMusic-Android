<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2EBFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- هدر یاسی با گرادیان -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="22dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙  خواب‌موزیک"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="موسیقی پخش می‌شه، وقتی تموم شد گوشی خودش خاموش می‌شه"
                android:textColor="#F0E3FB"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- کارت پلیر: نام آهنگ، رقص نور و زمان -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_step_circle"
                        android:backgroundTint="#F3EBFB"
                        android:gravity="center"
                        android:lineSpacingExtra="0dp"
                        android:padding="6dp"
                        android:text="🎵"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSelectedMusic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="هیچ فایلی انتخاب نشده"
                        android:textColor="#2A1840"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="آماده"
                        android:textColor="#E65100"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- رقص نور: موج پیوسته روی سفید، مثل عکس مرجع -->
                <ir.sleepmusic.app.EqualizerView
                    android:id="@+id/equalizerView"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_equalizer" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTimeElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#7A6A93"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlayerStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="آماده برای پخش"
                        android:textColor="#9C8DB5"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTimeTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textColor="#7A6A93"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- پخش: پخش می‌کند و بعد از پایان آهنگ گوشی را خاموش می‌کند -->
                <Button
                    android:id="@+id/btnPreview"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#F3EBFB"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="▶   پخش"
                    android:textColor="#6D28B8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <!-- کنترل‌ها -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="کنترل‌ها"
                android:textColor="#7E3FC0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPickMusic"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="انتخاب فایل موسیقی   ‹"
                android:textColor="#6D28B8"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="#B57FE4"
                app:strokeWidth="1.5dp" />

            <!-- حالت خاموشی -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="حالت خاموشی"
                    android:textColor="#2A1840"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioAfterMusic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#8E4FD0"
                        android:checked="true"
                        android:minHeight="40dp"
                        android:text="بلافاصله بعد از پایان موسیقی"
                        android:textColor="#2A1840"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/radioScheduled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#8E4FD0"
                        android:minHeight="40dp"
                        android:text="در ساعت مشخص (پشتیبان)"
                        android:textColor="#7A6A93"
                        android:textSize="12sp" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPickTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#F3EBFB"
                        android:text="انتخاب ساعت"
                        android:textColor="#6D28B8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <TextView
                        android:id="@+id/tvScheduledTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="زمان‌بندی: --:--"
                        android:textColor="#8E4FD0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- تنظیمات خاموشی -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchPowerMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="خاموشی واقعی بدون روت (منوی خاموشی)"
                    android:textColor="#2A1840"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPowerMenuHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="در پایان موسیقی، منوی خاموشی گوشی باز می‌شه؛ روی گوشی‌های شیائومی اپ خودش آیکون رو به سمت «خاموش کردن» می‌کشه و اگر دیالوگ تأیید بیاد خودش تأیید رو می‌زنه. اگر رام اجازه نده، صفحه قفل می‌شه."
                    android:textColor="#9C8DB5"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FDEEE0"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="توقف پخش"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="خواب‌موزیک • برای شب‌های آرام 🌙"
                android:textColor="#B3A6CC"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
