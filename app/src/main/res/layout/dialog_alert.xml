<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dlgAlertRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_grad_orange"
        android:gravity="center"
        android:text="⏰"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/dlgAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="۱۰ ثانیه تا خاموش شدن"
        android:textColor="#1F2937"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dlgAlertSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="خوابت برد؟ لغو کن تا موسیقی ادامه پیدا کند و خاموشی لغو شود."
        android:textColor="#8A7368"
        android:textSize="10sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_alert_track">

        <View
            android:id="@+id/alertBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_redbar" />
    </FrameLayout>

    <TextView
        android:id="@+id/btnAlertCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_grad_green"
        android:gravity="center"
        android:padding="11dp"
        android:text="✋ لغو خاموشی"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnAlertNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="همین حالا خاموش کن"
        android:textColor="#9A8FB5"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
